# =============================================
# BOOKING ZERO NO-SHOW OS — BACKEND ENVIRONMENT
# =============================================
# Copy this file to `.env` (same directory) and fill in real values.
# Never commit the real `.env` file — it is git-ignored.

# =============================================
# DATABASE
# =============================================

# Required — MongoDB connection string.
# Local:  mongodb://127.0.0.1:27017/booking_no_show
# Atlas:  mongodb+srv://<user>:<password>@<cluster>/<db>
MONGO_URL=

# =============================================
# AUTHENTICATION
# =============================================

# Required — long random string used to sign and verify JWTs.
# Generate one with:  openssl rand -base64 48
JWT_SECRET=

# =============================================
# SERVER
# =============================================

# Optional — port the API listens on (default: 5000)
# PORT=5000

# Optional — comma-separated list of allowed browser origins for CORS.
# Leave unset to allow any origin (local development). Set this in production
# to restrict the API to your frontend(s):
# CORS_ORIGIN=https://app.example.com,https://admin.example.com
# CORS_ORIGIN=

# =============================================
# WHATSAPP (Meta Cloud API)
# =============================================

# Optional — required only for WhatsApp notifications
# (POST /api/whatsapp/send and the scheduled booking reminders / no-show alerts).
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Optional — Meta Graph API version (default: v23.0)
# WHATSAPP_API_VERSION=v23.0

# =============================================
# SMS FALLBACK
# =============================================

# Optional — required only for SMS fallback when WhatsApp is unavailable
# or delivery fails. Used by the cron jobs via Fast2SMS.
FAST2SMS_KEY=

# =============================================
# PASSWORD RESET EMAIL (forgot-password flow)
# =============================================

# Optional — public URL of the frontend used to build password reset links.
# Defaults to http://localhost:3000 (development).
# FRONTEND_URL=https://app.example.com

# Optional — SMTP settings for the password reset email. When unset, the
# server logs the reset link to the console instead of sending an email
# (development fallback).
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=user@example.com
# SMTP_PASS=
# SMTP_FROM="NoShow OS <noreply@example.com>"